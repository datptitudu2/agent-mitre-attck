# ==============================================================================
# ATT&CK Lab — Mẫu Biến Môi Trường (.env.example)
# Sao chép thành .env.local khi chạy ở máy cá nhân (đã được .gitignore bảo vệ).
# TUYỆT ĐỐI KHÔNG commit giá trị thật của SERVICE_ROLE_KEY hay GITHUB_TOKEN!
# ==============================================================================

# --- 1. Frontend (Public - Được phép nhúng vào Vite bundle) -------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Để trống "" khi chạy cùng domain trên Vercel (1 project) hoặc qua Vite proxy local
VITE_API_URL=

# --- 2. Backend FastAPI & Script Sync (CHỈ Ở BACKEND / GITHUB ACTIONS) --------
SUPABASE_URL=https://your-project-ref.supabase.co
# Service Role Key: chỉ đặt ở .env.local (local), Vercel Env (Production), và GitHub Secrets
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Tuỳ chọn: Chỉ điền nếu project Supabase cũ hoặc Supabase CLI local dùng HS256.
# Các project Supabase mới mặc định xác thực tự động qua JWKS bất đối xứng (ES256/RS256).
SUPABASE_JWT_SECRET=

# Bảo vệ CORS khi gọi khác origin (phân tách bằng dấu phẩy)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- 3. Kích hoạt đồng bộ qua GitHub Actions (cho nút "Đồng bộ ngay" của Admin)
# Fine-grained Personal Access Token chỉ cấp quyền "Actions: Read and write" cho repo này
GITHUB_TOKEN_DISPATCH=
# Định dạng: owner/repo (ví dụ: ten-ban/attack-lab)
GITHUB_REPO=
GITHUB_WORKFLOW_FILE=sync.yml
GITHUB_WORKFLOW_REF=main

# Tuỳ chọn: Khoá bí mật nội bộ nếu gọi POST /api/sync từ CLI quản trị
SYNC_ADMIN_SECRET=
